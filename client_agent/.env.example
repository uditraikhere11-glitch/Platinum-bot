# --- Trading Signal Execution Client Configuration ---
# Copy this to .env and fill in your credentials.

# Shared local SQLite signal queue. Must match broadcaster and FnO worker.
DARVAS_SIGNAL_DB=/var/lib/darvas/signals.db
SIGNAL_QUEUE_POLL_SECONDS=0.25

# --- Broker Selection ---
# Set to "zerodha" or "dhan"
BROKER=dhan

# --- Zerodha Kite Connect credentials (if BROKER=zerodha) ---
KITE_API_KEY=your_kite_api_key
KITE_ACCESS_TOKEN=your_kite_access_token

# --- Dhan HQ credentials (if BROKER=dhan) ---
DHAN_CLIENT_ID=your_dhan_client_id
# Leave DHAN_ACCESS_TOKEN blank if you want the client to auto-generate it at startup!
DHAN_ACCESS_TOKEN=

# (Optional) Dhan Auto-Login credentials for generating the access token automatically:
DHAN_PIN=your_6_digit_pin
DHAN_TOTP_SECRET=your_totp_secret_key

# Set to "false" for LIVE trading (orders will be placed on your broker)
# Set to "true" for dry-run mode (orders are simulated/logged only)
DRY_RUN=true

# --- Execution Filters ---
# Optional: Comma-separated list of channel labels to execute trades for.
# If left empty, the client will execute trades for ALL channels.
# Example: ALLOWED_CHANNELS=premium,test
ALLOWED_CHANNELS=

# --- Capital Allocation ---
# Amount to invest per trade in INR (e.g., 10000). 
# The client will auto-calculate quantity = Floor(Amount / Price).
# If left empty or 0, the client defaults to buying 1 share.
TRADE_AMOUNT_INR=10000

# Fixed quantity fallback for MARKET orders where the exact price isn't known ahead of time.
DEFAULT_QUANTITY=1

# --- Optional stop-loss + target ---
# true = after each BUY EXECUTES (live or AMO), place a Dhan Forever OCO (target + stop-loss)
# for the executed quantity, at a % of the EXECUTED price Dhan reports. Nothing is placed for
# orders that don't execute.
EQUITY_SL_TARGET_ENABLED=false
# Required when enabled (e.g. 2 = stop-loss 2% below the executed price)
EQUITY_SL_PCT=
# Target % above the executed price
EQUITY_TARGET_PCT=1
# The stop-loss leg sells with a LIMIT this % below its trigger (so it fills in a fast fall)
EQUITY_SL_LIMIT_BUFFER_PCT=1

# Optional Telegram logs; blank values fall back to root .env TELEGRAM_LOG_BOT_TOKEN/chat IDs.
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_TEST_LOG_CHAT_ID=
TELEGRAM_LIVE_LOG_CHAT_ID=
