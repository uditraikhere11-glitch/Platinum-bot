# ---- FnO agent config (copy to fno_agent/.env) ----
BROKER=dhan                      # dhan | kite
DRY_RUN=true                     # true = log orders only; set false to trade live

# Shared local SQLite signal queue. Must match broadcaster and equity worker.
DARVAS_SIGNAL_DB=/var/lib/darvas/signals.db
SIGNAL_QUEUE_POLL_SECONDS=0.25
FNO_MAX_CONCURRENT_SIGNALS=1
FNO_MAX_SIGNAL_AGE_SEC=120
ALLOWED_CHANNELS=                # comma-separated channel labels; empty = all FnO channels

# Sizing: whole lots that fit this budget at the top of the entry range
FNO_CAPITAL_PER_TRADE=50000
FNO_MAX_LOTS=0                   # 0 = no cap

# Execution
FNO_CHASE_PCT=3                  # skip if LTP is more than this % above entry_max
FNO_ENTRY_TIMEOUT_SEC=300        # cancel unfilled entry after this long
FNO_MIN_DAYS_TO_EXPIRY=1         # never buy a contract expiring sooner than this
FNO_SL_LIMIT_BUFFER_PCT=5        # Kite GTT: SL leg limit price this % below the trigger
FNO_SL_TARGET_ENABLED=true       # false = buy only; no stop-loss/target at the broker
FNO_SL_PCT=3                     # stop-loss this % below the EXECUTED price (signal's own SL is ignored)
FNO_TARGET_PCT=3                 # one target this % above the EXECUTED price (signal's targets are ignored)
FNO_ENFORCE_MARKET_HOURS=true

# Dhan (TOTP auto-login refreshes the token daily)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_PIN=
DHAN_TOTP_SECRET=

# Kite (token file written daily by: python -m fno_agent.kite_login fno_agent/.env)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# KITE_TOKEN_FILE=fno_agent/.kite_token

# Telegram logs: blank FNO-specific values fall back to shared root .env settings.
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_TEST_LOG_CHAT_ID=
TELEGRAM_LIVE_LOG_CHAT_ID=
FNO_TG_BOT_TOKEN=
FNO_TG_CHAT_ID=
