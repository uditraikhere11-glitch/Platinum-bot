# Darvas Telegram input service. Copy to .env and fill your actual credentials.
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=
# Optional legacy single channel. Prefer CHANNEL_MAPPINGS below.
TG_TARGET_CHANNEL_ID=

# One object per input/source Telegram channel. Mode defaults to test when omitted.
# mode=test: receives/parses and writes to the TEST log chat only; never enters the live queue.
# mode=live: signals are queued only when LIVE_TRADING_ENABLED=true and feature flags are enabled.
# Example (replace IDs with your real channel IDs):
# CHANNEL_MAPPINGS=[{"telegram_channel_id":-1001111111111,"label":"my-test-channel","mode":"test","enable_trading":true,"enable_fno_trading":true,"discord_webhook_url":""},{"telegram_channel_id":-1002222222222,"label":"my-live-equity-channel","mode":"live","enable_trading":true,"enable_fno_trading":false,"discord_webhook_url":""}]
CHANNEL_MAPPINGS=

# Global fail-closed switch: keep false through testing. The listener won't queue any
# signals for execution until explicitly set true. Execution agents also have DRY_RUN=true by default.
LIVE_TRADING_ENABLED=false

# Shared local SQLite queue: same absolute path in root, client_agent and fno_agent configs.
DARVAS_SIGNAL_DB=/var/lib/darvas/signals.db
EQUITY_MAX_SIGNAL_AGE_SEC=120
FNO_MAX_SIGNAL_AGE_SEC=120
SIGNAL_QUEUE_POLL_SECONDS=0.25

# Telegram notification bot: add the bot to BOTH log destinations and allow it to post.
TELEGRAM_LOG_BOT_TOKEN=
# Output destination for mode=test source messages, parser previews and DRY_RUN worker outcomes.
TELEGRAM_TEST_LOG_CHAT_ID=
# Output destination for mode=live source decisions and workers with DRY_RUN=false.
TELEGRAM_LIVE_LOG_CHAT_ID=
# Legacy live-log destination if TELEGRAM_LIVE_LOG_CHAT_ID is empty; Telethon listener fallback only.
LOG_GROUP_ID=

# Optional integrations (production/live messages only)
VERTEX_PROJECT_ID=
GEMINI_LOCATION=global
GOOGLE_SHEET_ID=
NOTION_API_KEY=
NOTION_PAGE_ID=
DISCORD_WEBHOOK_URL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=
